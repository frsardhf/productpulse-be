# PostgreSQL and authentication secrets stay on the backend.
POSTGRES_PRISMA_URL=postgresql://postgres:postgres@localhost:5432/relicase
POSTGRES_URL_NON_POOLING=postgresql://postgres:postgres@localhost:5432/relicase
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated exact production/development frontend origins.
FRONTEND_ORIGINS=http://localhost:3001

# Optional Cloudflare Pages project hostname. HTTPS subdomains are accepted
# for branch and commit previews, for example abc123.relicase.pages.dev.
FRONTEND_PREVIEW_DOMAIN=relicase.pages.dev
