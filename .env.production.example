# PostgreSQL runs inside the private Compose network and is not publicly exposed.
POSTGRES_DB=relicase
POSTGRES_USER=relicase
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Use a separate long random value for signing authentication tokens.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Cloudflare Pages production URL and preview hostname.
FRONTEND_ORIGINS=https://relicase.pages.dev
FRONTEND_PREVIEW_DOMAIN=relicase.pages.dev
